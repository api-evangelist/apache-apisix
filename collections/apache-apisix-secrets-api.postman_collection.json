  "info": {
    "_postman_id": "a9ccdd57-fddd-4da4-bf56-da9c5f859242",
    "name": "Apache APISIX Admin Consumer Groups Secrets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Apache APISIX Admin API provides a RESTful interface to dynamically control and configure your deployed Apache APISIX instance. It allows management of routes, services, upstreams, consumers, SSL certificates, global rules, plugin configurations, consumer groups, secrets, and more. By default, the Admin API listens on port 9180 and requires API key authentication via the X-API-KEY header.\n\nContact Support:\n Name: Apache APISIX",
      "type": "text/plain"
    }
  }
