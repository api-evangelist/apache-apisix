{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache APISIX Admin Consumer Groups Protos API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Protos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache APISIX List All Protos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:9180/apisix/admin/protos"
          },
          "docs": "Fetches a list of all configured Protocol Buffer definition resources."
        },
        {
          "info": {
            "name": "Apache APISIX Get a Proto",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:9180/apisix/admin/protos/:proto_id",
            "params": [
              {
                "name": "proto_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the proto resource."
              }
            ]
          },
          "docs": "Fetches the specified Protocol Buffer definition by its ID."
        },
        {
          "info": {
            "name": "Apache APISIX Create or Update a Proto",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://127.0.0.1:9180/apisix/admin/protos/:proto_id",
            "params": [
              {
                "name": "proto_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the proto resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a proto with the specified ID, or updates it if it already exists."
        },
        {
          "info": {
            "name": "Apache APISIX Delete a Proto",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://127.0.0.1:9180/apisix/admin/protos/:proto_id",
            "params": [
              {
                "name": "proto_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the proto resource."
              }
            ]
          },
          "docs": "Removes the specified Protocol Buffer definition."
        }
      ]
    }
  ],
  "bundled": true
}